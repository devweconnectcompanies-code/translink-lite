{
  "manifest_version": 3,
  "name": "TransLink Lite",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "description": "Select and locally capture audio from one browser tab.",
  "permissions": ["tabs", "storage", "tabCapture", "offscreen"],
  "host_permissions": ["http://localhost/*", "https://localhost/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Open TransLink Lite"
  }
}
