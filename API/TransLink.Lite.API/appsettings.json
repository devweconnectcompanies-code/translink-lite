{
  "Jwt": {
    "Issuer": "TransLink.Lite",
    "Audience": "TransLink.Lite.Client",
    "ExpirationMinutes": 60
  },
  "RateLimiting": {
    "Authentication": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "RealtimeAudio": {
    "ProtocolVersion": 1,
    "MaxBinaryFrameBytes": 65560,
    "MaxControlMessageBytes": 4096,
    "ChunkDurationMs": 150,
    "HandshakeTimeoutSeconds": 10,
    "IdleTimeoutSeconds": 15,
    "MaxProtocolViolations": 1,
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
