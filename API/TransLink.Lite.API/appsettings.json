{
  "Jwt": {
    "Issuer": "TransLink.Lite",
    "Audience": "TransLink.Lite.Client",
    "ExpirationMinutes": 60
  },
  "RateLimiting": {
    "Authentication": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "RealtimeAudio": {
    "ProtocolVersion": 3,
    "MaxBinaryFrameBytes": 65560,
    "MaxControlMessageBytes": 4096,
    "ChunkDurationMs": 150,
    "HandshakeTimeoutSeconds": 10,
    "IdleTimeoutSeconds": 15,
    "MaxProtocolViolations": 1,
    "AllowedOrigins": []
  },
  "AwsTranscribe": {
    "Region": "us-east-1",
    "EnablePartialResultsStabilization": true,
    "PartialResultsStability": "medium",
    "AudioBufferCapacity": 8,
    "TranscriptBufferCapacity": 32,
    "AudioWriteTimeoutMilliseconds": 2000,
    "ProviderStartTimeoutSeconds": 10,
    "CompletionTimeoutSeconds": 10,
    "MaximumSessionMinutes": 60
  },
  "AwsPolly": {
    "WorkQueueCapacity": 4,
    "ProviderTimeoutSeconds": 10,
    "MaximumTextCharacters": 3000,
    "MaximumAudioBytes": 1048576
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
